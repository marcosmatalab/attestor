# Attestor - environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Every variable below is read by `src/attestor/config.py`. If you add one here that
# nothing reads, delete it instead: an unread variable advertises a capability the
# project does not have, and `extra="ignore"` swallows it in silence.
# tests/test_config_wiring.py enforces exactly that.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- C2PA signing (used from F4) ---
# A PEM certificate chain (leaf + CA) and the leaf private key, as PATHS. Leave both
# empty and a self-signed dev chain is generated per run, which is why this repo signs
# with no keys and no network. The loader that reads these paths is the seam a KMS/HSM
# signer would replace; no KMS backend ships here.
C2PA_CERT_PATH=
C2PA_PRIVATE_KEY_PATH=

# --- RFC3161 trusted timestamping authority (used from F4/F6) ---
# Optional. Without it, signing and sealing are fully offline.
RFC3161_TSA_URL=

# --- Cryptographic ledger: Ed25519 signing key (used from F6) ---
# Path only. The public key is what gets published; offline verification needs no more.
LEDGER_SIGNING_KEY_PATH=
