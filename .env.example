# Attestor - environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Every variable below is read by `src/attestor/config.py`. If you add one here
# that nothing reads, delete it instead: an unread variable advertises a
# capability the project does not have.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- C2PA signing material (optional) ---
# A local PEM chain and its private key. Leave both empty and the demo mints
# ephemeral development certificates, so the repo runs with no keys and no network.
# These are paths, never key values: the loader that reads them is the seam a
# KMS/HSM signer would replace. No KMS backend ships here.
C2PA_CERT_PATH=
C2PA_PRIVATE_KEY_PATH=

# --- RFC3161 trusted timestamping authority (optional) ---
# The engine performs no network I/O; a caller at the edge fetches the token.
RFC3161_TSA_URL=

# --- Cryptographic ledger: Ed25519 signing key (optional) ---
LEDGER_SIGNING_KEY_PATH=
